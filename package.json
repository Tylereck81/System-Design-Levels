{
  "name": "system-design-levels",
  "version": "0.1.0",
  "private": true,
  "description": "A drag-and-drop game for learning system design interviews, where you build architectures and watch simulated traffic.",
  "type": "module",
  "scripts": {
    "start": "serve -l 4173 .",
    "test": "npm run test:unit && playwright test --project=chromium",
    "test:unit": "node --test tests/unit/levels.test.mjs",
    "test:webkit": "playwright test --project=webkit",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "serve": "14.2.6"
  }
}
