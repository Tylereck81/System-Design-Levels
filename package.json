{
  "name": "system-design-levels",
  "version": "0.1.0",
  "private": true,
  "description": "A drag-and-drop game for learning system design interviews, where you build architectures and watch simulated traffic.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "serve -l 4173 .",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/levels.test.mjs tests/unit/catalog.test.mjs tests/unit/workloads.test.mjs",
    "test:e2e": "playwright test --project=chromium",
    "lint": "eslint js levels tests \"*.js\" --max-warnings 48",
    "test:webkit": "playwright test --project=webkit",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "serve": "14.2.6"
  }
}
